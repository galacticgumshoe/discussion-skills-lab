{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://discussion-skills-lab.invalid/schemas/id-progress.schema.json",
  "$comment": "NEW modules only. Unknown properties are preserved; unknown versions block writes. Activity defaults add type-specific runtime checks.",
  "type": "object", "additionalProperties": true,
  "required": ["schemaVersion", "completedSections", "activities", "fields", "flags", "ui"],
  "properties": {
    "schemaVersion": {"const": 1},
    "completedSections": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": {"enum": ["constructor", "prototype", "__proto__"]}}},
    "activities": {"type": "object", "additionalProperties": {"type": "object"}},
    "fields": {"type": "object", "additionalProperties": {"type": "string"}},
    "flags": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "ui": {"type": "object"}
  }
}
