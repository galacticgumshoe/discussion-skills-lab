{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://discussion-skills-lab.invalid/schemas/catalog.schema.json",
  "$comment": "Array order is published order. Semantic validation requires unique IDs, URL = ID.html and real entry/config/manifest destinations.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "lessons"],
  "properties": {
    "schemaVersion": {"const": 1},
    "lessons": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "url", "title", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": {"enum": ["constructor", "prototype", "__proto__"]}},
          "url": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.html$"},
          "title": {"type": "string", "pattern": "\\S"},
          "description": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  }
}
