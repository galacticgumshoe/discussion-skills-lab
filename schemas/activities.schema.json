{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://discussion-skills-lab.invalid/schemas/activities.schema.json",
  "$comment": "Closed standard activity envelope. Semantic/runtime checks additionally enforce unique IDs, correct option membership, feedback coverage, formatter fields/templates and writing bindings/modes.",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "type", "data"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["flashcards", "expandables", "multiple-choice", "question-sequence", "writing", "checklist", "note-classification"] },
    "data": { "type": "object" }, "profile": { "type": "string" },
    "binding": { "type": "object", "additionalProperties": false, "properties": { "assembledFlag": { "$ref": "#/$defs/id" }, "modelFlag": { "$ref": "#/$defs/id" }, "modelUi": { "$ref": "#/$defs/id" } } }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "flashcards" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/cards" }, "profile": false } } },
    { "if": { "properties": { "type": { "const": "expandables" } } }, "then": { "required": ["profile"], "properties": { "profile": { "enum": ["standard", "timeline"] }, "data": { "$ref": "#/$defs/panels" } } } },
    { "if": { "properties": { "type": { "const": "multiple-choice" } } }, "then": { "required": ["profile"], "properties": { "profile": { "enum": ["standard", "opening-classification", "opening-knowledge-check", "middle-scenarios", "middle-quiz", "middle-application", "final-questions"] }, "data": { "$ref": "#/$defs/question" } } } },
    { "if": { "properties": { "type": { "const": "question-sequence" } } }, "then": { "required": ["profile"], "properties": { "profile": { "enum": ["opening-classification", "opening-knowledge-check", "middle-scenarios", "middle-quiz", "middle-application", "final-questions"] }, "data": { "type": "object", "additionalProperties": false, "required": ["questions"], "dependencies": { "compareLabel": ["compareMessage"], "compareMessage": ["compareLabel"] }, "properties": { "heading": { "$ref": "#/$defs/text" }, "counterScoreLabel": { "$ref": "#/$defs/text" }, "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }, "retryLabel": { "$ref": "#/$defs/text" }, "compareLabel": { "$ref": "#/$defs/text" }, "compareMessage": { "$ref": "#/$defs/text" } } } } } },
    { "if": { "properties": { "type": { "const": "checklist" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/checks" }, "profile": false } } },
    { "if": { "properties": { "type": { "const": "note-classification" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/notes" }, "profile": false } } },
    { "if": { "properties": { "type": { "const": "writing" } } }, "then": { "required": ["profile"], "properties": { "profile": { "enum": ["draft", "opening-consensus", "middle-evidence", "final-synthesis"] }, "data": { "$ref": "#/$defs/writing" } } }, "else": { "properties": { "binding": false } } }
  ],
  "$defs": {
    "notes": {
      "type": "object", "additionalProperties": false, "required": ["categories", "notes", "chooseLabel", "correctPrefix", "wrongPrefix"],
      "properties": {
        "chooseLabel": { "$ref": "#/$defs/text" }, "correctPrefix": { "$ref": "#/$defs/text" }, "wrongPrefix": { "$ref": "#/$defs/text" },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" } } } },
        "notes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text", "correctCategoryId", "feedback"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" }, "correctCategoryId": { "$ref": "#/$defs/id" }, "feedback": { "$ref": "#/$defs/text" } } } }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": { "enum": ["constructor", "prototype", "__proto__"] } }, "text": { "type": "string", "pattern": "\\S" },
    "source": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.md$" },
    "cards": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id"], "allOf": [{ "oneOf": [{ "properties": { "front": {} }, "required": ["front"] }, { "properties": { "frontSource": {} }, "required": ["frontSource"] }] }, { "oneOf": [{ "properties": { "back": {} }, "required": ["back"] }, { "properties": { "backSource": {} }, "required": ["backSource"] }] }], "properties": { "id": { "$ref": "#/$defs/id" }, "front": { "$ref": "#/$defs/text" }, "back": { "$ref": "#/$defs/text" }, "frontSource": { "$ref": "#/$defs/source" }, "backSource": { "$ref": "#/$defs/source" }, "frontTitle": { "$ref": "#/$defs/text" }, "backTitle": { "$ref": "#/$defs/text" } } } } } },
    "panels": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "items": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "title"], "oneOf": [{ "properties": { "body": {} }, "required": ["body"] }, { "properties": { "bodySource": {} }, "required": ["bodySource"] }], "dependencies": { "calloutTones": ["bodySource"] }, "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "body": { "$ref": "#/$defs/text" }, "bodySource": { "$ref": "#/$defs/source" }, "calloutTones": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "enum": ["example", "caution"] } } } } } } },
    "checks": { "type": "object", "additionalProperties": false, "required": ["items"], "properties": { "caption": { "type": "object", "additionalProperties": false, "required": ["prefix", "empty"], "properties": { "prefix": { "$ref": "#/$defs/text" }, "empty": { "$ref": "#/$defs/text" } } }, "items": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" } } } } } },
    "question": { "type": "object", "additionalProperties": false, "required": ["id", "prompt", "correctOptionId", "options"], "properties": { "id": { "$ref": "#/$defs/id" }, "prompt": { "$ref": "#/$defs/text" }, "context": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" }, "correctOptionId": { "$ref": "#/$defs/id" }, "options": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" }, "feedback": { "$ref": "#/$defs/text" } } } } } },
    "field": { "type": "object", "additionalProperties": false, "required": ["id", "label", "multiline", "readonly"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "multiline": { "type": "boolean" }, "readonly": { "type": "boolean" }, "formatKey": { "$ref": "#/$defs/text" }, "placeholder": { "$ref": "#/$defs/text" }, "rows": { "type": "integer", "minimum": 1 }, "maxLength": { "type": "integer", "minimum": 1 } } },
    "writing": { "type": "object", "additionalProperties": false, "required": ["fields", "copyLabel"], "properties": {
      "edit": { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "label": { "$ref": "#/$defs/text" }, "message": { "$ref": "#/$defs/text" } } },
      "actionOrder": { "enum": ["edit-copy-model", "model-copy-edit"] }, "outputReveal": { "const": "assembled" },
      "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }, "output": { "$ref": "#/$defs/field" }, "copyFieldId": { "$ref": "#/$defs/id" }, "copyLabel": { "$ref": "#/$defs/text" },
      "copyMessages": { "type": "object", "additionalProperties": false, "properties": { "empty": { "$ref": "#/$defs/text" }, "copied": { "$ref": "#/$defs/text" }, "selected": { "$ref": "#/$defs/text" }, "fallback": { "$ref": "#/$defs/text" } } },
      "assembly": { "type": "object", "additionalProperties": false, "required": ["label", "template", "missingMessage", "successMessage", "focusOutput"], "properties": { "label": { "$ref": "#/$defs/text" }, "template": { "$ref": "#/$defs/text" }, "missingMessage": { "type": "string" }, "successMessage": { "type": "string" }, "focusOutput": { "type": "boolean" } } },
      "model": { "type": "object", "additionalProperties": false, "required": ["mode", "showLabel", "blocks"], "properties": { "mode": { "enum": ["show-only", "toggle"] }, "showLabel": { "$ref": "#/$defs/text" }, "hideLabel": { "$ref": "#/$defs/text" }, "blocks": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind"], "oneOf": [{ "properties": { "text": {} }, "required": ["text"] }, { "properties": { "source": {} }, "required": ["source"] }], "properties": { "kind": { "enum": ["title", "paragraph"] }, "text": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/source" } } } } } }
    } }
  }
}
