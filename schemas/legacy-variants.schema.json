{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://discussion-skills-lab.invalid/schemas/legacy-variants.schema.json",
  "title": "Non-published Middle source variants (never executable lesson content)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "legacy-variants" },
    "id": { "const": "middle" },
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "source", "value"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "status": { "const": "non-published" },
          "source": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["revision", "path", "symbol", "index"],
                "properties": {
                  "revision": { "const": "0b5d2297e7cbc19bd59cde750492dd28e3983ca0" },
                  "path": { "const": "assets/js/middle.js" }, "symbol": { "const": "strategies" },
                  "index": { "type": "integer", "minimum": 0, "maximum": 3 }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["revision", "path", "symbol"],
                "properties": {
                  "revision": { "const": "0b5d2297e7cbc19bd59cde750492dd28e3983ca0" },
                  "path": { "const": "assets/js/middle.js" }, "symbol": { "const": "referenceText" }
                }
              }
            ]
          },
          "value": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object", "additionalProperties": false,
                "required": ["title", "meaning", "advantage", "risk", "example"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 }, "meaning": { "type": "string", "minLength": 1 },
                  "advantage": { "type": "string", "minLength": 1 }, "risk": { "type": "string", "minLength": 1 },
                  "example": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
