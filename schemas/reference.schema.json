{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reference document v1 (MIT)",
  "description": "Only stacked-reference is supported. IDs are unique across document/items (semantic check). Sources are unencoded relative Markdown paths; resolved root containment and file existence are checked separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "layout", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "\\S" },
    "title": { "type": "string", "pattern": "\\S" },
    "layout": { "const": "stacked-reference" },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "number", "title", "accent", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "number": { "type": "string", "pattern": "\\S" },
          "title": { "type": "string", "pattern": "\\S" },
          "accent": { "enum": ["teal", "green", "orange", "purple", "blue"] },
          "source": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.md$" }
        }
      }
    }
  }
}
