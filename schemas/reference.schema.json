{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reference document v1 (MIT)",
  "description": "Explicit Final, Middle and Opening profiles. Opening uses four bounded reference groups and a badge, with six-step/definition/contribution/terminology lists. IDs are unique (semantic check). Sources are local Markdown paths; containment and existence checked separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "layout", "items"],
  "allOf": [{ "if": { "properties": { "layout": { "const": "opening-reference" } } }, "then": { "properties": { "items": { "type": "array", "minItems": 4, "maxItems": 4 } } }, "else": { "properties": { "badge": false } } }],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "\\S" },
    "title": { "type": "string", "pattern": "\\S" },
    "layout": { "enum": ["stacked-reference", "middle-reference", "opening-reference"] },
    "badge": { "type": "string", "pattern": "\\S" },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "number", "title", "accent", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "number": { "type": "string", "pattern": "\\S" },
          "title": { "type": "string", "pattern": "\\S" },
          "accent": { "enum": ["teal", "green", "orange", "purple", "blue"] },
          "source": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.md$" }
        }
      }
    }
  }
}
